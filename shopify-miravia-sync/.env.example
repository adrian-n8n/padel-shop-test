# Variables de entorno — Shopify → Miravia Sync
# Copia este archivo como .env y rellena los valores

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Miravia (Lazada Open Platform) ───────────────────────────────────────────
# Obtener en: https://sellercenter.miravia.es → Developer → My Apps
MIRAVIA_APP_KEY=123456
MIRAVIA_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIRAVIA_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=7000
