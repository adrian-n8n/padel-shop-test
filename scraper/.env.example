# Credenciales Shopify Admin API
# Copia este archivo como .env y rellena los valores

# Tu dominio de Shopify (sin https://)
SHOPIFY_STORE=tu-tienda.myshopify.com

# Token de Admin API
# Obtenerlo en: Admin → Settings → Apps & sales channels → Develop apps
# Permisos necesarios: write_products, read_products
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
